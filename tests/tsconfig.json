{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"allowSyntheticDefaultImports": true,
		"erasableSyntaxOnly": true,
		"esModuleInterop": true,
		"lib": ["ESNext", "ESNext.Disposable", "DOM"],
		"noEmit": true,
		"rootDir": "..",
		"target": "ES2022"
	},
	"include": ["**/*.ts", "*.ts"]
}
