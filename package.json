{
	"name": "@zenfs/dom",
	"version": "1.2.14",
	"description": "DOM backends for ZenFS",
	"funding": {
		"type": "individual",
		"url": "https://github.com/sponsors/james-pre"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"homepage": "https://github.com/zen-fs/dom",
	"author": "James Prevett <jp@jamespre.dev> (https://jamespre.dev)",
	"contributors": [
		"David Konsumer <konsumer@jetboystudio.com>"
	],
	"license": "LGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zen-fs/dom.git"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"bugs": {
		"url": "https://github.com/zen-fs/dom/issues"
	},
	"files": [
		"dist",
		"license.md",
		"tsconfig.json"
	],
	"engines": {
		"node": ">= 22"
	},
	"exports": {
		".": "./dist/index.js",
		"./*": "./dist/*.js",
		"./*.js": "./dist/*.js",
		"./devices": "./dist/devices/index.js"
	},
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint src",
		"build": "tsc -b",
		"test": "zenfs-test -abcf",
		"prepublishOnly": "tsc -b"
	},
	"devDependencies": {
		"@zenfs/devel": "^0.1.0",
		"eslint": "^10.1.0",
		"fake-indexeddb": "^6.0.0",
		"prettier": "^3.2.5",
		"typedoc": "^0.28.18",
		"typescript": "^6.0.0"
	},
	"peerDependencies": {
		"@zenfs/core": "^2.8.2",
		"kerium": "^1.5.0",
		"utilium": "^3.0.0"
	},
	"keywords": [
		"filesystem",
		"node",
		"storage"
	],
	"prettier": {
		"singleQuote": true,
		"useTabs": true,
		"trailingComma": "es5",
		"tabWidth": 4,
		"printWidth": 150,
		"arrowParens": "avoid"
	},
	"allowScripts": {
		"esbuild": true
	}
}
